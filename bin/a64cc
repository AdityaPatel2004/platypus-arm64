#!/usr/bin/env bash
# a64cc / a64c++ : the project's compiler driver (NATIVE aarch64 Ubuntu 24.04).
#
# Produces a BTI-ENFORCED executable, working around the fact that Ubuntu
# 24.04's glibc startup objects (Scrt1.o, crti.o, crtn.o) carry no BTI note:
#   - clang-20, -mbranch-protection=standard  (emit bti pads + PAC-ret)
#   - replace glibc's Scrt1.o with our own BTI-marked _start (runtime/crt_bti.o)
#   - use gcc's crtbeginS.o/crtendS.o, which ARE BTI-marked on 24.04
#   - omit glibc crti.o/crtn.o (no _init/_fini entered indirectly without a pad)
#   - -z force-bti stamps the GNU property note so the loader maps PROT_BTI
#
# JAIL=mask|check|audit   load the hardening pass + link the jail runtime
# JAIL_NO_FAKEPLT=1       ablation: disable address-taken-import stubs
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
GCCLIB=/usr/lib/gcc/aarch64-linux-gnu/13
case "$(basename "$0")" in *++) DRV=clang++-20 ;; *) DRV=clang-20 ;; esac

link=1; shared=0
for a in "$@"; do
  case "$a" in
    -c|-S|-E|-M|-MM) link=0 ;;
    -shared)         shared=1 ;;
  esac
done

args=(-mbranch-protection=standard)
if [ -n "${JAIL:-}" ] && [ "${JAIL:-}" != none ]; then
  # The pass reads the mode from the JAIL env var (inherited by clang), not an
  # -mllvm flag: -fpass-plugin loads after -mllvm parsing, so a plugin cl::opt
  # would be rejected. Export so the spawned clang sees it.
  export JAIL JAIL_NO_FAKEPLT
  args+=(-fpass-plugin="$ROOT/pass/libJailPass.so")
fi

# Linker warnings (notably the expected -z force-bti notes about BTI-less input
# objects) are kept, not suppressed, and tee'd to a log so they can be reviewed
# — relevant for libraries that may contain hand-written assembly without BTI.
WARNLOG="${A64CC_WARNLOG:-/tmp/a64cc_link_warnings.log}"

if [ "$link" = 1 ] && [ "$shared" = 0 ]; then
  # executable: supply our own BTI-marked _start (24.04 glibc crt lacks BTI)
  pre=(-nostartfiles "$ROOT/runtime/crt_bti.o" "$GCCLIB/crtbeginS.o"
       -Wl,-z,force-bti -Wl,-z,now -Wl,-z,relro)
  post=("$GCCLIB/crtendS.o")
  [ -n "${JAIL:-}" ] && [ "${JAIL:-}" != none ] && post=("$ROOT/runtime/jail_rt.o" "${post[@]}")
  exec "$DRV" "${args[@]}" "${pre[@]}" "$@" "${post[@]}" 2> >(tee -a "$WARNLOG" >&2)
elif [ "$link" = 1 ] && [ "$shared" = 1 ]; then
  # shared library: no _start/crt; still force the BTI note + link the jail rt
  pre=(-Wl,-z,force-bti -Wl,-z,now -Wl,-z,relro)
  post=()
  [ -n "${JAIL:-}" ] && [ "${JAIL:-}" != none ] && post=("$ROOT/runtime/jail_rt.o")
  exec "$DRV" "${args[@]}" "${pre[@]}" "$@" "${post[@]}" 2> >(tee -a "$WARNLOG" >&2)
else
  exec "$DRV" "${args[@]}" "$@"
fi
